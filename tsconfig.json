{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": [
    "banks/**/*.ts",
    "banks/**/*.js",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "app/**/*.ts",
    "vitest.config.ts"
  ]
}
